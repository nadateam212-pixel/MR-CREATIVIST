MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/platform_db
MONGODB_DB=platform_db
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_TLS=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
MONGODB_CONNECT_TIMEOUT_MS=8000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_PUBLIC_QUERY_TIMEOUT_MS=8000
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
# Local development can keep localhost. In Vercel production set all three URLs to:
# https://mrcreativist.vercel.app
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
VERCEL_PROJECT_PRODUCTION_URL=mrcreativist.vercel.app
NEXT_PUBLIC_COURSE_PREVIEW_SECONDS=120

# Email delivery for OTP and password reset links.
# On Vercel production, OTP/reset email will not reach users until these are set.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="MrCreativist <sales@example.com>"
EMAIL_FROM="MrCreativist <sales@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL="MrCreativist <sales@example.com>"
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=sales@example.com
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sales@example.com
MAIL_FROM_NAME=MrCreativist
INTOUCH_BASE_URL=https://www.intouchpay.co.rw
INTOUCH_USERNAME=your-intouch-username
INTOUCH_ACCOUNT_NO=250000000000
INTOUCH_PARTNER_PASSWORD=change-me
INTOUCH_CALLBACK_PATH=/api/intouchpay/callback
INTOUCH_CALLBACK_URL=https://your-domain.com/api/intouchpay/callback
INTOUCH_TIMEOUT_MS=20000

# Firebase web auth and push.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mrcreativist.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mrcreativist
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mrcreativist.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=403584587333
NEXT_PUBLIC_FIREBASE_APP_ID=1:403584587333:web:b980810328d7181964b52c
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-9JCEBD2X2B
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-web-push-certificate-key

# Required only for server-sent Firebase push notifications.
FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"mrcreativist","client_email":"firebase-adminsdk@mrcreativist.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# AI
GEMINI_API_KEY=AIza...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Pricing display
# Approximate USD to Rwandan franc rate. Update this value when finance changes.
NEXT_PUBLIC_USD_TO_FRW_RATE=1463
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_CACHE_SECONDS=3600

# Media storage
# Use server-only secrets here. Never expose API secrets with NEXT_PUBLIC_.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret
VIMEO_ACCESS_TOKEN=vimeo_access_token
VIMEO_CLIENT_ID=optional_vimeo_client_id
VIMEO_CLIENT_SECRET=optional_for_future_oauth_flows
MAX_HOSTED_UPLOAD_MB=500
